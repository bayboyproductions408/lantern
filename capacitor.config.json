{
  "appId": "com.bayboyproductions.lantern",
  "appName": "Lantern",
  "webDir": "www",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#14110f",
    "limitsNavigationsToAppBoundDomains": true
  },
  "android": {
    "backgroundColor": "#14110f"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#14110f",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
